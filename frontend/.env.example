# Production same-origin proxy mode (recommended): browser calls /api and
# the Next.js server proxies to the .NET API origin. Do not add the /api suffix.
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8081

# For a separate public API origin instead, set NEXT_PUBLIC_API_BASE_URL to
# https://api.your-domain.example/api and configure backend FrontendOrigin.
# In direct mode, API_PROXY_TARGET is not used by the browser.
